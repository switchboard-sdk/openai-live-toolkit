<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Merged into every consuming app: mic capture + network for GPT-Live. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice-communication audio routing (speakerphone + AEC) via AudioManager. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Keeps the mic open with the screen locked or the app in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Shows the service's notification on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".OpenAILiveToolkitService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="true" />
        <!-- Lets the share sheet read the log file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.openailivetoolkit.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/openailivetoolkit_files" />
        </provider>
    </application>
</manifest>
