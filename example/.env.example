# OpenAILiveToolkit example. Copy to .env (gitignored) and fill in:
#   cp .env.example .env
#
# ai-coustics license key for speaker isolation. Optional: leave empty to run
# without it. Also needs `OPENAI_LIVE_AICOUSTICS=1 bundle exec pod install`.
AIC_LICENSE_KEY=
# Switchboard app and backend. Optional: leave empty for the shared app on
# production. For staging, set all three to a staging app and
# SWITCHBOARD_API_URL=https://staging.api.switchboard.audio
SWITCHBOARD_APP_ID=
SWITCHBOARD_APP_SECRET=
SWITCHBOARD_API_URL=
